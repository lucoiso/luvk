{
    "version":  6,
    "cmakeMinimumRequired":  {
                                 "major":  3,
                                 "minor":  28,
                                 "patch":  0
                             },
    "configurePresets":  [
                             {
                                 "name":  "base",
                                 "hidden":  true,
                                 "generator":  "Ninja",
                                 "binaryDir":  "${sourceDir}/../luvk-build/${presetName}",
                                 "cacheVariables":  {
                                                        "CMAKE_EXPORT_COMPILE_COMMANDS":  "ON"
                                                    }
                             },
                             {
                                 "name":  "debug",
                                 "inherits":  "base",
                                 "displayName":  "luvk core (Debug)",
                                 "cacheVariables":  {
                                                        "CMAKE_BUILD_TYPE":  "Debug"
                                                    }
                             },
                             {
                                 "name":  "release",
                                 "inherits":  "base",
                                 "displayName":  "luvk core (Release)",
                                 "cacheVariables":  {
                                                        "CMAKE_BUILD_TYPE":  "Release"
                                                    }
                             },
                             {
                                 "name":  "debug-apps",
                                 "inherits":  "debug",
                                 "displayName":  "luvk + app + example (Debug)",
                                 "cacheVariables":  {
                                                        "LUVK_BUILD_APP":  "ON",
                                                        "LUVK_BUILD_EXAMPLE":  "ON"
                                                    }
                             },
                             {
                                 "name":  "release-apps",
                                 "inherits":  "release",
                                 "displayName":  "luvk + app + example (Release)",
                                 "cacheVariables":  {
                                                        "LUVK_BUILD_APP":  "ON",
                                                        "LUVK_BUILD_EXAMPLE":  "ON"
                                                    }
                             }
                         ],
    "buildPresets":  [
                         {
                             "name":  "debug",
                             "configurePreset":  "debug"
                         },
                         {
                             "name":  "release",
                             "configurePreset":  "release"
                         },
                         {
                             "name":  "debug-apps",
                             "configurePreset":  "debug-apps"
                         },
                         {
                             "name":  "release-apps",
                             "configurePreset":  "release-apps"
                         }
                     ]
}
