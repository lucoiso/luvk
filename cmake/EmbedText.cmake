# Script mode (cmake -P): writes OUTPUT, a header declaring NAME as a char array with the bytes of INPUT (no terminator),
# so text of any size (string literals are limited to 16 KiB on MSVC) is compiled into the binary.

FILE(READ "${INPUT}" HEX HEX)
STRING(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," BYTES "${HEX}")
STRING(REGEX REPLACE "(([^,]*,){24})" "\\1\n    " BYTES "${BYTES}")
FILE(WRITE "${OUTPUT}" "// Generated by luvk/cmake/EmbedText.cmake from ${INPUT}. Do not edit.\n\n#pragma once\n\ninline constexpr char ${NAME}[] = {\n    ${BYTES}\n};\n")
