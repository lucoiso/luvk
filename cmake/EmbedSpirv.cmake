# Script mode (cmake -P), driven by LUVK_EMBED_SHADERS: writes HEADER and SOURCE with one accessor per SPIR-V module of
# MANIFEST ("Entry|Entry|..."), reading <SPIRV_DIR>/<Entry>.spv as little-endian 32-bit words.

STRING(REPLACE "|" ";" ENTRIES "${MANIFEST}")

SET(DECLARATIONS "")
SET(DEFINITIONS "")

FOREACH (NAME IN LISTS ENTRIES)
    FILE(READ "${SPIRV_DIR}/${NAME}.spv" HEX HEX)
    STRING(LENGTH "${HEX}" HEX_LENGTH)
    MATH(EXPR REMAINDER "${HEX_LENGTH} % 8")
    IF (NOT REMAINDER EQUAL 0 OR HEX_LENGTH EQUAL 0)
        MESSAGE(FATAL_ERROR "${NAME}.spv is not a valid SPIR-V module")
    ENDIF ()

    STRING(REGEX REPLACE "([0-9a-f][0-9a-f])([0-9a-f][0-9a-f])([0-9a-f][0-9a-f])([0-9a-f][0-9a-f])" "0x\\4\\3\\2\\1U," WORDS "${HEX}")
    STRING(REGEX REPLACE "(([^,]*,){12})" "\\1\n        " WORDS "${WORDS}")

    STRING(APPEND DECLARATIONS "    /** SPIR-V of the ${NAME} entry point. */\n    [[nodiscard]] std::span<const std::uint32_t> ${NAME}() noexcept;\n\n")
    STRING(APPEND DEFINITIONS "std::span<const std::uint32_t> ${NAMESPACE}::${NAME}() noexcept\n{\n    static constexpr std::uint32_t Words[] = {\n        ${WORDS}\n    };\n    return Words;\n}\n\n")
ENDFOREACH ()

FILE(WRITE "${HEADER}" "// Generated by luvk/cmake/EmbedSpirv.cmake. Do not edit.\n\n#pragma once\n\n#include <cstdint>\n#include <span>\n\nnamespace ${NAMESPACE}\n{\n${DECLARATIONS}}\n")
FILE(WRITE "${SOURCE}" "// Generated by luvk/cmake/EmbedSpirv.cmake. Do not edit.\n\n#include \"${HEADER_NAME}\"\n\n${DEFINITIONS}")
